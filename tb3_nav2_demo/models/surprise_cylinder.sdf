<?xml version="1.0"?>
<!-- Unmapped obstacle: Nav2 must detect it with the lidar, not the map. -->
<sdf version="1.6">
  <model name="surprise_cylinder">
    <static>true</static>
    <link name="link">
      <pose>0 0 0.25 0 0 0</pose>
      <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.5</length></cylinder></geometry></collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.22</radius><length>0.5</length></cylinder></geometry>
        <material><ambient>0.85 0.1 0.1 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
